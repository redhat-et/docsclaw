# Multi-arch index: a per-architecture digest pin builds only that architecture
# and fails the other with "Exec format error". The project is pre-production,
# so the minor tag floats rather than pinning a digest; `make image-openshell`
# builds with --pull=newer so UBI's CVE rebuilds are picked up.
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.3

LABEL org.opencontainers.image.source="https://github.com/redhat-et/docsclaw" \
      org.opencontainers.image.description="DocsClaw agent runtime for NVIDIA OpenShell sandboxes" \
      org.opencontainers.image.licenses="Apache-2.0"

USER root

# `openshell sandbox upload` extracts into the sandbox with tar, and UBI
# minimal does not ship it, so delivering an agent config over the harness
# fails without this.
RUN microdnf install -y tar && microdnf clean all

# OpenShell provider profiles bind credentials to this exact binary path and
# pin the first observed digest, so copy to the real path with no symlink.
ARG TARGETPLATFORM
COPY --chmod=0755 --chown=root:root $TARGETPLATFORM/docsclaw /usr/local/bin/docsclaw

# serve defaults to /workspace. OpenShell treats a non-/sandbox WORKDIR as the
# sandbox workspace, so it must exist and be writable by the runtime user.
# The Kubernetes driver mounts the workspace PVC at /sandbox, so that path must
# exist too; keeping both lets a consumer use one path on either driver.
RUN mkdir -p /workspace /sandbox \
    && chown 1001:1001 /workspace /sandbox \
    && chmod 0775 /workspace /sandbox

# OpenShell refuses to start a sandbox whose workload identity carries a zero
# UID or GID ("workload identity must not contain UID or GID zero"), so this is
# a plain non-root pair rather than the OpenShift gid-0 convention.
USER 1001:1001
WORKDIR /workspace

# OpenShell replaces CMD/ENTRYPOINT when it starts the sandbox. This default
# keeps the container alive for the harness's `-- sleep infinity` pattern.
CMD ["sleep", "infinity"]
